{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Keylens Configuration",
  "description": "Configuration file for Keylens keyboard navigation testing.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "profile": {
      "type": "string",
      "enum": ["fast", "balanced", "thorough"],
      "default": "balanced",
      "description": "Execution preset applied before explicit option overrides."
    },
    "urls": {
      "type": "array",
      "items": { "type": "string", "format": "uri" },
      "description": "URLs to audit."
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0, "default": 1280 },
        "height": { "type": "number", "exclusiveMinimum": 0, "default": 720 }
      }
    },
    "maxTabs": {
      "type": "integer",
      "minimum": 1,
      "default": 500,
      "description": "Max Tab presses before aborting."
    },
    "tabTimeout": {
      "type": "number",
      "exclusiveMinimum": 0,
      "default": 3000
    },
    "waitForSelector": {
      "type": "string",
      "minLength": 1,
      "description": "CSS selector to wait for before starting."
    },
    "waitAfterLoad": {
      "type": "number",
      "minimum": 0,
      "default": 1000
    },
    "tabDelay": {
      "type": "number",
      "default": 250,
      "minimum": 10,
      "description": "Delay in ms between tab presses to let focus settle."
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "keyboardTrap": { "type": "boolean", "default": true },
        "unreachableElements": { "type": "boolean", "default": true },
        "focusOrderMismatch": { "type": "boolean", "default": true },
        "tabindexAbuse": { "type": "boolean", "default": true },
        "missingFocusIndicator": { "type": "boolean", "default": true },
        "skipLink": { "type": "boolean", "default": true },
        "focusNotObscured": { "type": "boolean", "default": true },
        "focusAfterInteraction": { "type": "boolean", "default": true },
        "rovingTabindexBroken": { "type": "boolean", "default": true }
      }
    },
    "reporters": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["cli", "json", "html", "markdown"]
      },
      "default": ["cli"]
    },
    "outputDir": {
      "type": "string",
      "minLength": 1,
      "default": "./keylens-report"
    },
    "browser": {
      "type": "string",
      "enum": ["chromium", "firefox", "webkit"],
      "default": "chromium"
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "description": "Bounded screenshot capture policy. Programmatic audits default to no page screenshot.",
      "properties": {
        "page": {
          "type": "string",
          "enum": ["none", "viewport", "full"],
          "default": "none"
        },
        "elements": { "type": "boolean", "default": false },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxElements": { "type": "integer", "minimum": 0, "default": 200 },
            "maxDimension": {
              "type": "integer",
              "minimum": 1,
              "default": 16384
            },
            "maxPixels": {
              "type": "integer",
              "minimum": 1,
              "default": 40000000
            },
            "maxBytes": {
              "type": "integer",
              "minimum": 1,
              "default": 52428800
            }
          }
        }
      }
    },
    "timeouts": {
      "type": "object",
      "additionalProperties": false,
      "description": "Enforced wall-time budgets for audit phases.",
      "properties": {
        "total": { "type": "number", "exclusiveMinimum": 0 },
        "crawl": { "type": "number", "exclusiveMinimum": 0 },
        "rules": { "type": "number", "exclusiveMinimum": 0 },
        "interactions": { "type": "number", "exclusiveMinimum": 0 },
        "ai": { "type": "number", "exclusiveMinimum": 0 },
        "reporters": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "interactions": {
      "type": "object",
      "additionalProperties": false,
      "description": "Bounded post-activation focus testing.",
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "maxCases": { "type": "integer", "minimum": 0, "default": 20 },
        "timeout": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 2000
        },
        "include": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "exclude": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "actions": {
          "type": "array",
          "items": { "enum": ["click", "enter", "space"] },
          "default": ["click"]
        },
        "isolation": { "enum": ["reload", "none"], "default": "reload" },
        "navigation": { "enum": ["block", "allow"], "default": "block" },
        "excludeDestructive": { "type": "boolean", "default": true }
      }
    },
    "multiPage": {
      "type": "object",
      "additionalProperties": false,
      "description": "Browser reuse and bounded concurrency for multi-page audits.",
      "properties": {
        "concurrency": { "type": "integer", "minimum": 1, "default": 2 }
      }
    },
    "ai": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "provider": {
          "type": "string",
          "enum": ["anthropic", "openai"],
          "default": "anthropic",
          "description": "AI provider. Use 'openai' for OpenAI, Azure AI Foundry, or any OpenAI-compatible endpoint."
        },
        "apiKey": { "type": "string" },
        "model": { "type": "string", "minLength": 1 },
        "baseURL": {
          "type": "string",
          "format": "uri",
          "description": "Base URL for the AI provider. Set this for Azure AI Foundry or other custom OpenAI-compatible endpoints."
        },
        "features": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "focusOrderValidation": { "type": "boolean", "default": true },
            "fixSuggestions": { "type": "boolean", "default": true },
            "widgetClassification": { "type": "boolean", "default": false },
            "reportSummary": { "type": "boolean", "default": true },
            "focusIndicatorQuality": { "type": "boolean", "default": false },
            "accessibleNameInference": { "type": "boolean", "default": false },
            "crossPagePatterns": { "type": "boolean", "default": true }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "description": "Batch and element limits for AI features.",
          "properties": {
            "batchSize": {
              "type": "integer",
              "default": 10,
              "minimum": 1,
              "description": "Fix suggestion chunk size."
            },
            "maxWidgets": {
              "type": "integer",
              "default": 20,
              "minimum": 1,
              "description": "Max widgets for classification."
            },
            "maxElements": {
              "type": "integer",
              "default": 10,
              "minimum": 1,
              "description": "Max elements per AI feature call (name inference, focus scoring, cross-page)."
            }
          }
        }
      }
    },
    "navigationTimeout": {
      "type": "number",
      "exclusiveMinimum": 0,
      "default": 30000,
      "description": "Timeout in ms for page navigation (default: 30000)."
    },
    "headed": {
      "type": "boolean",
      "default": false
    },
    "prepare": {
      "type": "object",
      "additionalProperties": false,
      "description": "Overlay/consent-banner dismissal run after navigation, before capture and crawl.",
      "properties": {
        "dismissOverlays": {
          "type": "boolean",
          "default": true,
          "description": "Auto-detect and dismiss known cookie/consent banners (OneTrust, Cookiebot, etc.), falling back to a generic heuristic."
        },
        "consentPreference": {
          "enum": ["reject", "accept", "close"],
          "default": "reject",
          "description": "Which action to prefer when a banner offers multiple choices."
        },
        "dismissSelectors": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Extra CSS selectors to click before auditing, for banners not covered by built-in presets."
        },
        "timeout": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 5000,
          "description": "Whole-phase wall-time budget in ms."
        },
        "cookies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "value"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "value": { "type": "string" },
              "domain": { "type": "string", "minLength": 1 },
              "path": { "type": "string", "minLength": 1 }
            }
          },
          "description": "Cookies applied to the browser context before navigation."
        },
        "steps": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "selector"],
                "properties": {
                  "type": { "const": "click" },
                  "selector": { "type": "string", "minLength": 1 },
                  "optional": { "type": "boolean" }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "key"],
                "properties": {
                  "type": { "const": "press" },
                  "key": { "type": "string", "minLength": 1 }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "ms"],
                "properties": {
                  "type": { "const": "wait" },
                  "ms": { "type": "number", "minimum": 0 }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "selector"],
                "properties": {
                  "type": { "const": "waitFor" },
                  "selector": { "type": "string", "minLength": 1 },
                  "timeout": { "type": "number", "exclusiveMinimum": 0 }
                }
              }
            ]
          },
          "description": "Generic scripted steps run after overlay dismissal (click/press/wait/waitFor)."
        },
        "expandScrollContainers": {
          "type": "boolean",
          "default": true,
          "description": "Detect and neutralize full-page 'faux scroll' containers (overflow:auto wrappers used by parallax/smooth-scroll designs instead of the document itself) so page height, full-page screenshots, and the HTML focus map reflect the true page length."
        }
      }
    }
  }
}
