{
  "name": "@telerik/keylens",
  "version": "0.1.0",
  "description": "Real-browser keyboard navigation testing for the CLI, CI, and programmatic audits.",
  "keywords": [
    "accessibility",
    "a11y",
    "keyboard",
    "navigation",
    "testing",
    "focus-order",
    "tab-order",
    "wcag",
    "cli",
    "audit"
  ],
  "homepage": "https://github.com/telerik/keylens#readme",
  "bugs": {
    "url": "https://github.com/telerik/keylens/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/telerik/keylens.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "license": "Apache-2.0",
  "author": "Progress Software Corporation",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./mcp": {
      "import": "./dist/mcp/server.js",
      "types": "./dist/mcp/server.d.ts"
    },
    "./guidance": {
      "import": "./dist/guidance.js",
      "types": "./dist/guidance.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "keylens": "./dist/cli/index.js",
    "keylens-mcp": "./dist/mcp/server.js"
  },
  "files": [
    "dist",
    "skill",
    "keylens.config.schema.json",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "SUPPORT.md"
  ],
  "scripts": {
    "build": "node --env-file-if-exists=.env node_modules/.bin/tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/ tests/ benchmarks/",
    "lint:fix": "eslint src/ tests/ benchmarks/ --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "benchmark": "tsx benchmarks/run.ts",
    "benchmark:ci": "KEYLENS_BENCHMARK_ENFORCE=1 KEYLENS_BENCHMARK_OUTPUT=benchmark-results.json tsx benchmarks/run.ts",
    "benchmark:typecheck": "tsc --noEmit -p benchmarks/tsconfig.json",
    "package:verify": "npm run build && node scripts/verify-package.mjs",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run benchmark:typecheck && npm run build && npm run docs:build && npm run test:coverage",
    "keylens": "node --env-file-if-exists=.env node_modules/.bin/tsx src/cli/index.ts",
    "prepublishOnly": "npm run build",
    "prepare": "git config core.hooksPath .husky",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:og-image": "node scripts/generate-og-image.mjs",
    "docs:demo": "npm run build && node scripts/generate-homepage-demo.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "ora": "^9.4.1",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "zod": "^4.5.4"
  },
  "optionalDependencies": {
    "@telerik/machine-id": "^1.6.14"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^26.4.1",
    "@types/pngjs": "^6.0.5",
    "@vitest/coverage-v8": "^5.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "semantic-release": "^25.0.9",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml}": [
      "prettier --write"
    ]
  }
}
